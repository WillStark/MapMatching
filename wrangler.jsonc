{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "geosync",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Per-invocation brakes (cf-guardrails). OpenNext SSR needs more CPU than a plain Worker; 1000 ms is
	// well above normal page renders but stops runaway loops long before the 30 s default.
	// subrequests: Nominatim search/details + OpenNext asset/cache/self-reference calls stay far below 50.
	// https://developers.cloudflare.com/workers/wrangler/configuration/#limits
	"limits": {
		"cpu_ms": 1000,
		"subrequests": 50
	},
	// Keep Workers Logs on, sampled at 10% of invocations.
	// https://developers.cloudflare.com/workers/observability/logs/workers-logs/
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "geosync"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}